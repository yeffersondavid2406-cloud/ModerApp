PORT=3000

# Clave de Google AI Studio. Nunca la subas al repositorio.
GEMINI_API_KEY=
# Modelo de Gemini. Si tu cuenta no tiene acceso, cambia este valor.
AI_MODEL=gemini-3.6-flash

# Versión de la API de Gemini. v1beta es la que funciona con el modelo actual.
AI_API_VERSION=v1beta

# Tiempo máximo de espera por lote (milisegundos).
AI_TIMEOUT_MS=30000

# Cantidad de comentarios por solicitud a Gemini.
# 8 funciona bien con la capa gratuita y evita respuestas truncadas.
AI_BATCH_SIZE=8

# Pon false para forzar el clasificador por reglas incluso con clave.
AI_ENABLED=true
